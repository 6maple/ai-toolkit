{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["env.d.ts", "lib/**/*.ts", "plugins/**/*.ts", ".vitepress/**/*.ts", "vite.config.ts"]
}
