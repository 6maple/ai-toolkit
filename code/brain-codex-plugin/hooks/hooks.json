{
  "description": "Restore Brain context before every user prompt.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/ai-projects/ai-toolkit/code/brain-codex-plugin/dist/user-prompt-submit.mjs\"",
            "commandWindows": "node \"D:\\Workspace\\ai-projects\\ai-toolkit\\code\\brain-codex-plugin\\dist\\user-prompt-submit.mjs\"",
            "timeout": 10,
            "statusMessage": "Preparing Brain context",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^mcp__brain__brain_edit$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Workspace/ai-projects/ai-toolkit/code/brain-codex-plugin/dist/permission-request.mjs\"",
            "commandWindows": "node \"D:\\Workspace\\ai-projects\\ai-toolkit\\code\\brain-codex-plugin\\dist\\permission-request.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking Brain edit safety"
          }
        ]
      }
    ]
  }
}
